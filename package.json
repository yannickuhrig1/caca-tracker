{
  "name": "caca-tracker",
  "version": "2.11.0",
  "description": "Caca-Tracker 3000 Deluxe — PWA vanilla JS de suivi des selles",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./css/tailwind.css --watch",
    "build:qrcode": "esbuild src/qrcode-entry.js --bundle --minify --platform=browser --format=iife --global-name=QRCode --outfile=vendor/qrcode.min.js",
    "fetch:fonts": "python scripts/fetch-fonts.py",
    "test": "node --test \"test/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannickuhrig1/caca-tracker.git"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "qrcode": "^1.5.3",
    "tailwindcss": "^3.4.17"
  },
  "private": "true"
}
